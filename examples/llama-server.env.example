# Copy to ~/.config/pc-guard/llama-server.env (chmod 600). Read by
# systemd/llama-server.service.in -> scripts/llama-server-start.
LLAMA_MODEL=/path/to/models/model.gguf
# LLAMA_BIN=/path/to/llama.cpp/build/bin/llama-server
# LLAMA_ALIAS=local-model
# Must match llamacpp_url in pc-guard.conf.
# LLAMA_PORT=8080
# LLAMA_CTX=16384
# LLAMA_UBATCH=64
# LLAMA_N_CPU_MOE=99
# LLAMA_REASONING_BUDGET=0
# LLAMA_EXTRA_ARGS=
